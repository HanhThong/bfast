{
  "name": "bfast",
  "displayName": "BFAST",
  "description": "BFAST Model",
  "publisher": "HanhThong",
  "license": "Apache-2.0",
  "homepage": "https://bfast.hanhthong.me/",
  "repository": {
    "type": "git",
    "url": "https://github.com/HanhThong/bfast.git"
  },
  "bugs": {
    "url": "https://github.com/HanhThong/bfast/issues"
