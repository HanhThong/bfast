    "viewsContainers": {
      "activitybar": [
        {
          "id": "bfast",
          "title": "BFAST",
          "icon": "media/bfast.svg"
        }
      ]
    },
    "views": {
      "bfast": [
        {
          "id": "bfast.sidebar",
          "name": "Tickets",
          "icon": "media/bfast.svg"
        },
        {
          "id": "bfast.environments",
          "name": "Environments",
          "icon": "media/bfast.svg"
        },
        {
          "id": "bfast.scan",
          "name": "Code Quality",
          "icon": "media/bfast.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "bfast.sidebar",
        "contents": "No folder is open, so BFAST has nowhere to store its settings.\n[Open Folder](command:workbench.action.files.openFolder)",
        "when": "workbenchState == empty"
      },
      {
        "view": "bfast.sidebar",
        "contents": "BFAST is not set up for this workspace yet.\nChoose the folder holding the tracker store and the name to show on ticket history.\n[Init settings](command:bfast.openSettings)",
        "when": "workbenchState != empty && !bfast.configured"
      },
      {
        "view": "bfast.environments",
        "contents": "Set up BFAST before creating environments.\n[Init settings](command:bfast.openSettings)",
        "when": "workbenchState != empty && !bfast.configured"
      },
      {
        "view": "bfast.environments",
        "contents": "No environments yet.\nRight-click a story or an epic in Tickets and choose “Create Environment”, or:\n[New Environment](command:bfast.newEnvironment)\nFor the workspace folder itself, no ticket needed:\n[Create Master Environment](command:bfast.createMasterEnvironment)\nPrepare your compose file first — see docs/environments/docker-compose.md.",
        "when": "bfast.configured"
      },
      {
        "view": "bfast.scan",
        "contents": "Set up BFAST before scanning.\n[Init settings](command:bfast.openSettings)",
        "when": "workbenchState != empty && !bfast.configured"
      },
      {
        "view": "bfast.scan",
        "contents": "No scan server yet.\nBFAST can deploy SonarQube for this workspace, or point at one you already have.\n[Deploy Scan Server](command:bfast.deployScanServer)\nCheck the Scan tab in settings first — see docs/scan/configuration.md.",
        "when": "bfast.configured"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "bfast.newEpic",
          "when": "view == bfast.sidebar && bfast.configured",
          "group": "navigation@0"
        },
        {
          "command": "bfast.filterTickets",
          "when": "view == bfast.sidebar && bfast.configured",
          "group": "navigation@1"
