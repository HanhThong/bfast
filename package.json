  "version": "0.1.0",
  "engines": {
    "vscode": "^1.134.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "BFAST runs the workspace's committed test command and stack tooling on a click, so it stays off in Restricted Mode."
    }
  },
  "main": "./out/extension.js",
